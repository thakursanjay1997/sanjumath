  "quizzes": [
    {
      "id": "quiz_1",
      "title": "Class 10 Math: Quadratic Equations Concept Drill",
      "grade": 10,
      "subject": "Mathematics",
      "questions": [
        {
          "q": "What is the discriminant formula for standard quadratic ax² + bx + c = 0?",
          "options": [
            "D = b² - 4ac",
            "D = b² + 4ac",
            "D = 4ac - b²",
            "D = √b - 4ac"
          ],
          "correct": 0,
          "explanation": "The discriminant formula is strictly D = b² - 4ac."
        },
        {
          "q": "When D = 0, what is the nature of the roots of the quadratic equation?",
          "options": [
            "No real roots (imaginary)",
            "Two equal real roots",
            "Two distinct irrational roots",
            "Infinite roots"
          ],
          "correct": 1,
          "explanation": "When D = 0, both roots are equal and real: x = -b / (2a)."
        }
      ]
    },
    {
      "id": "quiz_2",
      "title": "Class 10 Math: Real Numbers & Prime Factorisation Drill",
      "grade": 10,
      "subject": "Mathematics",
      "questions": [
        {
          "q": "According to the Fundamental Theorem of Arithmetic, every composite number can be factored as a product of:",
          "options": [
            "Primes uniquely, apart from the order",
            "Any integers uniquely",
            "Odd numbers only",
            "Fractions"
          ],
          "correct": 0,
          "explanation": "Every composite number can be uniquely expressed as a product of prime powers."
        },
        {
          "q": "If HCF(a, b) = 4 and a × b = 96, what is LCM(a, b)?",
          "options": [
            "24",
            "48",
            "16",
            "384"
          ],
          "correct": 0,
          "explanation": "HCF × LCM = a × b => 4 × LCM = 96 => LCM = 24."
        }
      ]
    },
    {
      "id": "quiz_3",
      "title": "Class 10 Math: Arithmetic Progressions (AP) Diagnostic",
      "grade": 10,
      "subject": "Mathematics",
      "questions": [
        {
          "q": "What is the 10th term of the AP: 2, 7, 12, ...?",
          "options": [
            "47",
            "52",
            "45",
            "50"
          ],
          "correct": 0,
          "explanation": "a = 2, d = 5. a₁₀ = 2 + (10 - 1)×5 = 2 + 45 = 47."
        },
        {
          "q": "The formula for the sum of the first n terms of an AP with first term 'a' and last term 'l' is:",
          "options": [
            "Sₙ = (n / 2)(a + l)",
            "Sₙ = n(a + l)",
            "Sₙ = (n / 2)(2a + l)",
            "Sₙ = 2n(a + l)"
          ],
          "correct": 0,
          "explanation": "Sₙ = (n / 2)(a + l) where l is the nth term."
        }
      ]
    },
    {
      "id": "quiz_4",
      "title": "Class 10 Physics: Light Reflection & Refraction Concept Test",
      "grade": 10,
      "subject": "Physics",
      "questions": [
        {
          "q": "What is the refractive index formula using angles of incidence (i) and refraction (r)?",
          "options": [
            "sin i / sin r",
            "sin r / sin i",
            "cos i / cos r",
            "tan i / tan r"
          ],
          "correct": 0,
          "explanation": "Snell's Law states n = sin i / sin r."
        },
        {
          "q": "What is the focal length of a convex lens whose power is +2.0 Diopters?",
          "options": [
            "+0.5 m (+50 cm)",
            "+2.0 m",
            "-0.5 m",
            "+1.0 m"
          ],
          "correct": 0,
          "explanation": "f = 1 / P = 1 / (+2.0 D) = +0.5 meters (+50 cm)."
        }
      ]
    },
    {
      "id": "quiz_5",
      "title": "Class 10 Physics: Electricity & Resistance Test Drill",
      "grade": 10,
      "subject": "Physics",
      "questions": [
        {
          "q": "Two resistors of 6 Ω and 3 Ω are connected in parallel. What is the equivalent resistance?",
          "options": [
            "2 Ω",
            "9 Ω",
            "4.5 Ω",
            "1 Ω"
          ],
          "correct": 0,
          "explanation": "1/Rₚ = 1/6 + 1/3 = 3/6 = 1/2 => Rₚ = 2 Ω."
        },
        {
          "q": "Which law states that heat generated in a conductor is directly proportional to I²Rt?",
          "options": [
            "Joule's Law of Heating",
            "Ohm's Law",
            "Faraday's Law",
            "Ampere's Law"
          ],
          "correct": 0,
          "explanation": "Joule's law states H = I²Rt."
        }
      ]
    }
